{
  "schemaVersion": 1,
  "id": "pauth",
  "version": "${version}",
  "name": "PAuth",
  "description": "Server-side mod for offline and online auth with automatic premium detection",
  "authors": [
    "zaralX"
  ],
  "contact": {
    "sources": "https://github.com/buerak0/PAuth"
  },
  "license": "All Rights Reserved",
  "environment": "server",
  "entrypoints": {
